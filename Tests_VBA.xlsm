================================================================================
SECTION XVI : Effacer plage de données avec confirmation
================================================================================

Sub_TestEffacerPlage()
    ' Test de l'effacement de plage avec confirmation
    Dim debutRange As String
    Dim finRange As String
    Dim reponse As VbMsgBoxResult

    debutRange = InputBox("Coordonnée de départ de la plage (ex: A1):")
    finRange = InputBox("Coordonnée de fin de la plage (ex: B10):")

    If debutRange <> "" And finRange <> "" Then
        reponse = MsgBox "Voulez-vous vraiment effacer les données de la plage " & _
                         debutRange & " : " & finRange & " ?", _
                         vbYesNo + vbDefaultButton2, "Confirmation"

        If reponse = vbYes Then
            On Error Resume Next
            Range(debutRange & ":" & finRange).ClearContents
            On Error GoTo 0
            MsgBox "Les données de la plage " & debutRange & " : " & finRange & " ont été effacées.", vbInformation
        Else
            MsgBox "Opération annulée. Aucune donnée n'a été effacée.", vbInformation
        End If
    End If
End Sub

================================================================================
TP ASSISTÉS - MACROS DE TEST
================================================================================

Sub_TestCourbeGaussienne()
    ' Test de génération de points selon courbe de Gauss
    Dim i As Integer
    Dim message As String
    Dim mean As Double, stdDev As Double

    mean = 0
    stdDev = 1
    message = "Exemple de génération de courbe de Gauss (moyenne=" & mean & ", écart-type=" & stdDev & ")" & vbCrLf & vbCrLf

    For i = -3 To 3 Step 0.5
        ' Formule de la courbe de Gauss: f(x) = (1/(σ√(2π))) * e^(-(x-μ)²/(2σ²))
        Dim val As Double
        val = (1 / (stdDev * Sqr(2 * 3.14159265358979))) * Exp(-((i - mean) ^ 2) / (2 * stdDev ^ 2))
        message = message & "x=" & i & " => f(x)=" & Round(val, 4) & vbCrLf
    Next i

    MsgBox message, vbInformation, "Courbe de Gauss"
End Sub

Sub_TestCreationFormulaire()
    ' Test de création d'un user form basique
    MsgBox "Cette fonction teste la création de formulaires." & vbCrLf & _
           "En VBA, utilisez l'éditeur UserForm pour créer des interfaces.", vbInformation
End Sub

Sub_TestQuestionsVBA()
    ' Test de questions de révision VBA
    Dim score As Integer
    Dim reponses(1 To 5, 1 To 2) As String

    reponses(1, 1) = "Quelle instruction sert à déclarer une variable?"
    reponses(1, 2) = "Dim"

    reponses(2, 1) = "Comment ajouter des bordures à une plage?"
    reponses(2, 2) = "BorderAround"

    reponses(3, 1) = "Comment appeler une procédure avec un paramètre optionnel?"
    reponses(3, 2) = "Call maProcedure(r:=5)"

    reponses(4, 1) = "Quelle fonction retourne le plus grand de deux nombres?"
    reponses(4, 2) = "MaxDeuxNombres"

    reponses(5, 1) = "Comment calculer la factorielle de manière récursive?"
    reponses(5, 2) = "FactorielleRecursive(n-1)"

    score = InputBox("Combien de réponses connaissez-vous ? (1-5)", "Questions VBA")

    MsgBox "Score: " & score & "/5", vbInformation, "Questions VBA"
End Sub

