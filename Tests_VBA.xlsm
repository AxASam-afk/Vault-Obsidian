Sub_TestFonctionMiroire()
    ' Test de la fonction miroir
    Dim resultat As String

    resultat = Miroire("Bonjour")
    MsgBox "Miroire(""Bonjour"") = " & resultat & " (attendu: ""ruojnoB"")", vbInformation

    resultat = Miroire("VBA")
    MsgBox "Miroire(""VBA"") = " & resultat & " (attendu: ""ABV"")", vbInformation

    resultat = Miroire("12345")
    MsgBox "Miroire(""12345"") = " & resultat & " (attendu: ""54321"")", vbInformation

    resultat = Miroire("")
    MsgBox "Miroire(""") = " & resultat & " (attendu: """")", vbInformation
End Sub

================================================================================
SECTION XIV : Fonction nombre premier
================================================================================

Sub_TestEstPremier()
    ' Test de la fonction EstPremier
    Dim testVals As Variant
    Dim i As Integer
    Dim resultat As Boolean
    Dim message As String

    testVals = Array(2, 3, 4, 5, 97, 100, 0, 1)
    message = "Résultats du test EstPremier :" & vbCrLf & vbCrLf

    For i = LBound(testVals) To UBound(testVals)
        resultat = EstPremier(testVals(i))
        message = message & "EstPremier(" & testVals(i) & ") = " & IIf(resultat, "Vrai", "Faux") & vbCrLf
    Next i

    MsgBox message, vbInformation, "Test Nombre Premier"
End Sub

