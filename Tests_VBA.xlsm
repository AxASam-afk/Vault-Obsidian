================================================================================
SECTION I : Création de macro avec feuille nouvelle
================================================================================

Sub Test_CreerFeuilleDeBase()
    ' Test de la macro de base qui crée une feuille NF01 avec données
    Dim ws As Worksheet
    Dim nextSheetNum As Integer
    Dim sheetName As String
    Dim i As Integer

    ' Trouver nom unique
    nextSheetNum = 1
    Do While True
        sheetName = "NF" & Format(nextSheetNum, "00")
        On Error Resume Next
        Set ws = ThisWorkbook.Worksheets(sheetName)
        On Error GoTo 0
        If ws Is Nothing Then Exit Do
        nextSheetNum = nextSheetNum + 1
    Loop

    ' Ajouter feuille
    Set ws = ThisWorkbook.Worksheets.Add(After:=ThisWorkbook.Worksheets(ThisWorkbook.Worksheets.Count))
    ws.Name = sheetName

    ' Entrer valeurs
    ws.Range("A1").Value = 10
    ws.Range("A2").Value = 20
    ws.Range("A3").Value = 30

    ' Formule somme
    ws.Range("A4").Formula = "=SUM(A1:A3)"

    ' Bordures
    ws.Range("A1:A4").BorderAround LineStyle:=xlContinuous, Weight:=xlThin

    MsgBox "Feuille '" & sheetName & "' créée avec succès!" & vbCrLf & _
           "A1=" & ws.Range("A1").Value & ", A2=" & ws.Range("A2").Value & ", A3=" & ws.Range("A3").Value & vbCrLf & _
           "Formule A4: " & ws.Range("A4").Formula, vbInformation
End Sub

Sub Test_CreerFeuilleInteractive()
    ' Test de la version interactive avec saisie utilisateur
    Dim sheetName As String
    Dim ws As Worksheet
    Dim sheetExists As Boolean
    Dim reponse As VbMsgBoxResult

    reponse = MsgBox "Voulez-vous ajouter une nouvelle feuille de calcul?", vbYesNo + vbQuestion
    If reponse = vbNo Then Exit Sub

    sheetName = InputBox("Entrez le nom de la feuille souhaitée :")
    If sheetName = "" Then Exit Sub

    ' Vérifier si le nom est déjà utilisé
    sheetExists = False
    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(sheetName)
    On Error GoTo 0

    If Not ws Is Nothing Then
        sheetExists = True
        MsgBox "Le nom '" & sheetName & "' est déjà utilisé!" & vbCrLf & _
               "Veuillez choisir un autre nom.", vbExclamation
        Exit Sub
    End If

    ' Créer la feuille
    Set ws = ThisWorkbook.Worksheets.Add
    ws.Name = sheetName

    ' Valeurs par défaut
    ws.Range("A1").Value = 10
    ws.Range("A2").Value = 20
    ws.Range("A3").Value = 30

    ' Formule
    ws.Range("A4").Formula = "=SUM(A1:A3)"

    ' Bordures
    ws.Range("A1:A4").BorderAround LineStyle:=xlContinuous, Weight:=xlThin

    MsgBox "Feuille '" & sheetName & "' créée avec succès!", vbInformation
End Sub

================================================================================
SECTION II : Conteneurs Range et Cells
================================================================================

Sub Test_RemplirBlocRange()
    ' Remplir la plage A1:B5 avec 42
    Range("A1:B5").Value = 42
    MsgBox "Plage A1:B5 remplie avec 42", vbInformation
End Sub

Sub Test_RemplirPlageUtilisateur()
    ' Remplir une plage dont les bornes sont saisies par l'utilisateur
    Dim debutRange As String
    Dim finRange As String
    Dim valeur As String

    debutRange = InputBox("Coordonnée de départ (ex: A1):")
    finRange = InputBox("Coordonnée de fin (ex: B10):")
    valeur = InputBox("Valeur à saisir:")

    If debutRange <> "" And finRange <> "" And valeur <> "" Then
        On Error Resume Next
        Range(debutRange & ":" & finRange).Value = valeur
        On Error GoTo 0
        MsgBox "Plage " & debutRange & " : " & finRange & " remplie avec " & valeur, vbInformation
    End If
End Sub

Sub Test_BoutonSaisie()
    ' Crée un bouton qui saisit une valeur dans la sélection
    Dim btn As Button
    Set btn = ActiveSheet.Buttons.Add( _
        Left:=ActiveCell.Left, _
        Width:=100, _
        Top:=ActiveCell.Top + ActiveCell.Height, _
        Height:=25)

    btn.Caption = "Saisir valeur"
    Set btn.OnAction = "SaisirValeurSelection"
End Sub

Sub SaisirValeurSelection()
    Dim valeur As String
    valeur = InputBox("Valeur à affecter à la sélection actuelle :")
    If valeur <> "" Then
        Selection.Value = valeur
    End If
End Sub

