Sub Test_TraceCercle()
    ' Test de la procédure tracecercle
    ' Avec paramètres ordonnés
    Call tracecercle(0, 0, 5)
    MsgBox "Procédure tracecercle appelée avec paramètres ordonnés", vbInformation
End Sub

Sub Test_TraceCercleNommes()
    ' Avec paramètres nommés
    Call tracecercle(x:=0, y:=0, r:=5)
    MsgBox "Procédure tracecercle appelée avec paramètres nommés", vbInformation
End Sub

Sub Test_ProduitCinqVars()
    ' Test de la fonction produit de 5 variables
    Dim resultat As Double

    ' Avec tous les paramètres
    resultat = ProduitCinqVars(1, 2, 3, 4, 5)
    MsgBox "ProduitCinqVars(1,2,3,4,5) = " & resultat & " (attendu: 120)", vbInformation

    ' Avec paramètres par défaut
    resultat = ProduitCinqVars(1, 2, 3)
    MsgBox "ProduitCinqVars(1,2,3) = " & resultat & " (attendu: 12)", vbInformation

    ' Avec paramètres nommés
    resultat = ProduitCinqVars(a:=1, b:=2, e:=3)
    MsgBox "ProduitCinqVars(a:=1,b:=2,e:=3) = " & resultat & " (attendu: 6)", vbInformation
End Sub

================================================================================
SECTION IV : Fonction MAX de deux nombres
================================================================================

Sub Test_MaxDeuxNombres()
    ' Test de la fonction MaxDeuxNombres
    Dim val1 As Double, val2 As Double
    Dim resultat As Double

    val1 = InputBox("Entrez la première valeur :")
    val2 = InputBox("Entrez la deuxième valeur :")

    If IsNumeric(val1) And IsNumeric(val2) Then
        resultat = MaxDeuxNombres(CDbl(val1), CDbl(val2))
        MsgBox "Le plus grand des deux nombres est : " & resultat, vbInformation
    Else
        MsgBox "Veuillez entrer des valeurs numériques valides.", vbExclamation
    End If
End Sub

================================================================================
SECTION V : Fonction factorielle
================================================================================

Sub_TestFactorielle()
    ' Test de la procédure factorielle avec validation de saisie
    Dim n As Long
    Dim resultat As Double

    Do
        n = InputBox("Entrez la valeur de n pour calculer sa factorielle :", "Saisie de n")

        If Not IsNumeric(n) Then
            MsgBox "Veuillez entrer une valeur numérique.", vbExclamation
            Continue Do
        End If

        n = CInt(n)

        If n < 0 Then
            MsgBox "La factorielle d'un nombre négatif n'a pas de sens. Veuillez réessayez.", vbExclamation
            Continue Do
        End If

        If n > 10 Then
            MsgBox "Attention : n = " & n & " est trop grand (> 10). Sortie de la procédure.", vbExclamation
            Exit Sub
        End If

        Exit Do

    Loop

    ' Calcul itératif
    resultat = FactorielleIterative(n)
    MsgBox "Factorielle(" & n & ") (itérative) : " & resultat, vbInformation

    ' Calcul récursif
    resultat = FactorielleRecursive(n)
    MsgBox "Factorielle(" & n & ") (récursive) : " & resultat, vbInformation
End Sub

================================================================================
SECTION VI : Gestion d'erreurs en VBA
================================================================================

Sub_TestResume()
    ' Test de la gestion avec Resume
    On Error Resume Next

    Dim t(10) As Double
    t(11) = 25.321 ' Cette ligne génère une erreur

    If Err.Number <> 0 Then
        MsgBox "Erreur n°" & Err.Number & ": " & Err.Description
        Err.Clear
    End If

    MsgBox "Nous sommes passés après l'erreur"
End Sub

Sub_TestGestionComplete()
    ' Test de la gestion complète avec Error Handler
    On Error GoTo GestionErreur

    Dim t(10) As Double
    t(11) = 25.321 ' Cette ligne génère une erreur

    MsgBox "Nous sommes passés avant l'erreur"
    Exit Sub

GestionErreur:
    MsgBox "Erreur n°" & Err.Number & ": " & Err.Description & vbCrLf & _
           "Impossible de continuer.", vbCritical
    Resume Next
End Sub

================================================================================
SECTION VII : Recherche de sous-chaîne
================================================================================

Sub_TestRechercheSousChaine()
    ' Test de la fonction RechercheSousChaine
    Dim chaine As String
    Dim sousChaine As String
    Dim posDebut As Long
    Dim position As Long

    chaine = InputBox("Entrez la chaîne principale :")
    sousChaine = InputBox("Entrez la sous-chaine à rechercher :")
    posDebut = InputBox("Entrez la position de départ (1 par défaut):")
    If posDebut = "" Then posDebut = 1

    position = RechercheSousChaine(chaine, sousChaine, posDebut)

    If position > 0 Then
        MsgBox "La sous-chaine est trouvée à la position " & position, vbInformation
    Else
        MsgBox "La sous-chaine n'est pas présente dans la chaîne donnée à partir de la position " & posDebut, vbExclamation
    End If
End Sub

