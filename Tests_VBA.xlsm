Sub_TestExtraireNomExtension()
    ' Test de la fonction ExtraireNomExtension
    Dim resultat As String

    resultat = ExtraireNomExtension("classeur.xls")
    MsgBox "ExtraireNomExtension(""classeur.xls"") = " & resultat & " (attendu: ""classeur et xls"")", vbInformation

    resultat = ExtraireNomExtension("document.pdf")
    MsgBox "ExtraireNomExtension(""document.pdf"") = " & resultat & " (attendu: ""document et pdf"")", vbInformation

    resultat = ExtraireNomExtension("sans_extension")
    MsgBox "ExtraireNomExtension(""sans_extension"") = " & resultat, vbInformation
End Sub

================================================================================
SECTION IX : Saisie et vérification de type de cellule
================================================================================

Sub_TestVerifierTypeCellule()
    ' Test de la procédure de vérification de type
    Dim valeurSaisie As String
    Dim choix As VbMsgBoxResult

    valeurSaisie = InputBox("Entrez une valeur de cellule à vérifier :")

    choix = MsgBox "Vouez-vous vérifier si le type est :" & vbCrLf & vbCrLf & _
                   "1. Une date" & vbCrLf & _
                   "2. Un entier", _
                   vbQuestion + vbYesNoNo, "Type de données"

    Select Case choix
        Case vbYes
            If IsDate(valeurSaisie) Then
                MsgBox "C'est une date!" & vbCrLf & _
                       "Formats possibles :" & vbCrLf & _
                       "- Format court : " & Format(CDate(valeurSaisie), "dd/mm/yyyy") & vbCrLf & _
                       "- Format long : " & Format(CDate(valeurSaisie), "dddd dd mmmm yyyy") & vbCrLf & _
                       "- Format US : " & Format(CDate(valeurSaisie), "mm/dd/yyyy"), vbInformation
            Else
                MsgBox "Ce n'est pas une date.", vbInformation
            End If

        Case vbNo
            If IsNumeric(valeurSaisie) Then
                Dim nb As Double
                nb = CDouble(valeurSaisie)

                If nb <= 100 Then
                    MsgBox "C'est un entier <= 100." & vbCrLf & _
                           "Affichage en pourcentage : " & Format(nb / 100, "0%"), vbInformation
                Else
                    MsgBox "C'est un entier > 100." & vbCrLf & _
                           "Affichage avec symbole € : " & nb & " €", vbInformation
                End If
            Else
                MsgBox "Ce n'est pas un nombre valide.", vbInformation
            End If

        Case vbNull
            MsgBox "Aucune vérification effectuée.", vbInformation
    End Select
End Sub

================================================================================
SECTION X : Tableaux 2 dimensions
================================================================================

Sub_TestTableau2Dimensions()
    ' Test du tableau 2D 5x6
    Dim tab(1 To 5, 1 To 6) As Integer
    Dim i As Integer, j As Integer
    Dim message As String

    ' Saisir les valeurs
    For i = 1 To 5
        For j = 1 To 6
            tab(i, j) = InputBox("Entrez la valeur pour tab(" & i & ", " & j & "):")
        Next j
    Next i

    ' Afficher
    message = "Contenu du tableau 5x6 :" & vbCrLf & vbCrLf
    For i = 1 To 5
        For j = 1 To 6
            message = message & "tab(" & i & ", " & j & ") = " & tab(i, j) & vbTab
        Next j
        message = message & vbCrLf
    Next i

    MsgBox message, vbInformation, "Tableau 2D"
End Sub

================================================================================
SECTION XI : Tableaux 3 dimensions de réels
================================================================================

Sub_TestTableau3Dimensions()
    ' Test du tableau 3D 5x4x3
    Dim tab(1 To 5, 1 To 4, 1 To 3) As Double
    Dim i As Integer, j As Integer, k As Integer
    Dim message As String

    ' Saisir les valeurs
    For i = 1 To 5
        For j = 1 To 4
            For k = 1 To 3
                tab(i, j, k) = InputBox("Entrez la valeur pour tab(" & i & ", " & j & ", " & k & "):")
            Next k
        Next j
    Next i

    ' Afficher
    message = "Contenu du tableau 5x4x3 :" & vbCrLf & vbCrLf
    For i = 1 To 5
        For j = 1 To 4
            For k = 1 To 3
                message = message & "tab(" & i & ", " & j & ", " & k & ") = " & tab(i, j, k) & vbTab
            Next k
            message = message & vbCrLf
        Next j
        message = message & vbCrLf & "---" & vbCrLf
    Next i

    MsgBox message, vbInformation, "Tableau 3D"
End Sub

================================================================================
SECTION XII : Événement Double-clic sur cellule
================================================================================

' NOTE : Ce code doit être placé dans l'éditeur VBA dans l'événement
' Worksheet_BeforeDoubleClick de la feuille concernée

Private Sub Worksheet_BeforeDoubleClick(ByVal Target As Range, Cancel As Boolean)
    ' Afficher message avec adresse et nom de feuille
    MsgBox "Double-clic sur la cellule " & Target.Address & vbCrLf & _
           "Dans la feuille : " & Me.Name, vbInformation

    ' Empêcher la cellule de passer en mode mise à jour
    Cancel = True
End Sub

Sub_TestEvenementDoubleClic()
    ' Macro de test - affiche un message explicatif
    MsgBox "Pour tester l'événement double-clic :" & vbCrLf & vbCrLf & _
           "1. Ouvrez l'éditeur VBA (Alt+F11)" & vbCrLf & _
           "2. Double-cliquez sur une feuille dans l'explorateur" & vbCrLf & _
           "3. Collez le code Worksheet_BeforeDoubleClick" & vbCrLf & _
           "4. Double-cliquez sur une cellule dans Excel", vbInformation
End Sub

